# ============================================================
# PhysioAI Pro V2 - Environment Configuration Template
# ============================================================
# Copy this file to .env and adjust values for your environment.
# ============================================================

APP_NAME=PhysioAI Pro V2
APP_VERSION=2.0.0
APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

WS_MAX_CONNECTIONS=50
WS_HEARTBEAT_INTERVAL=30
WS_MAX_MESSAGE_SIZE=1048576

MAX_FPS=25
TARGET_FPS=20
MAX_FRAME_SIZE_BYTES=524288

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

LOG_LEVEL=DEBUG
LOG_FORMAT=console
